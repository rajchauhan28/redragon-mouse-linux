# Redragon M693 (Areson/Compx 25a7:fa7b wired, 25a7:fa7c 2.4G receiver)
# Grant users in the 'input' group access to the vendor hidraw interface.
KERNEL=="hidraw*", ATTRS{idVendor}=="25a7", ATTRS{idProduct}=="fa7b", MODE="0660", GROUP="input", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="25a7", ATTRS{idProduct}=="fa7c", MODE="0660", GROUP="input", TAG+="uaccess"

# Keep the USB receiver and mouse out of runtime autosuspend to prevent
# xhci_hcd reset storms and missed 2.4 GHz wake packets.
ACTION=="add|bind|change", SUBSYSTEM=="usb", ATTR{idVendor}=="25a7", ATTR{idProduct}=="fa7b", ATTR{power/control}="on", ATTR{power/autosuspend}="-1"
ACTION=="add|bind|change", SUBSYSTEM=="usb", ATTR{idVendor}=="25a7", ATTR{idProduct}=="fa7c", ATTR{power/control}="on", ATTR{power/autosuspend}="-1"
